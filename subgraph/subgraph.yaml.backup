specVersion: 1.0.0
indexerHints:
  prune: auto
schema:
  file: ./schema.graphql
dataSources:
  - kind: ethereum
    name: Holons.sol
    network: mainnet
    source:
      address: "0xe4eb561155afce723bb1ff8606fbfe9b28d5d38d"
      abi: Holons.sol
      startBlock: 0
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      entities:
        - NewFlavor
        - NewHolon
      abis:
        - name: Holons.sol
          file: ./abis/Holons.json
      eventHandlers:
        - event: NewFlavor(indexed address,string)
          handler: handleNewFlavor
        - event: NewHolon(string,address)
          handler: handleNewHolon
      file: ./src/holons-sol.ts

templates:
  - name: Splitter
    kind: ethereum/contract
    network: mainnet
    source:
      abi: Splitter
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      file: ./src/splitter-template.ts
      entities:
        - HolonContract
        - RewardDistribution
        - MemberReward       
      abis:
        - name: Splitter
          file: ./abis/Splitter.json
      eventHandlers:
        - event: RewardDistributed(indexed address,uint256,uint256,string)
          handler: handleRewardDistributed
        - event: MemberRewarded(indexed address,indexed address,uint256,bool,string)
          handler: handleMemberRewarded
        - event: FundsForwarded(address,address,uint256)
          handler: handleFundsForwarded
        - event: ChildRewardTriggered(address,address,uint256)
          handler: handleChildRewardTriggered

  - name: Zoned
    kind: ethereum/contract
    network: mainnet
    source:
      abi: Zoned
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      file: ./src/zoned-template.ts
      entities:
        - HolonContract
        - RewardDistribution
        - MemberReward       
      abis:
        - name: Zoned
          file: ./abis/Zoned.json
      eventHandlers:
        - event: RewardDistributed(indexed address,uint256,uint256,string)
          handler: handleRewardDistributed
        - event: MemberRewarded(indexed address,indexed address,uint256,bool,string)
          handler: handleMemberRewarded

  - name: Managed
    kind: ethereum/contract
    network: mainnet
    source:
      abi: Managed
    mapping:
      kind: ethereum/events
      apiVersion: 0.0.7
      language: wasm/assemblyscript
      file: ./src/managed-template.ts
      entities:
        - HolonContract
        - RewardDistribution
        - MemberReward       
      abis:
        - name: Managed
          file: ./abis/Managed.json
      eventHandlers:
        - event: RewardDistributed(indexed address,uint256,uint256,string)
          handler: handleRewardDistributed
        - event: MemberRewarded(indexed address,indexed address,uint256,bool,string)
          handler: handleMemberRewarded